# Copier en .env pour lancer l'application hors Docker (node --env-file=.env ...).
# Ne jamais committer de .env : les secrets de préprod et de prod sont injectés par l'hébergeur.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# 32 caractères minimum. Générer par exemple avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# memory (développement seulement, interdit en production) ou postgres
SESSION_STORE=memory
# DATABASE_URL=postgres://attesta:attesta-dev-uniquement@localhost:5432/attesta

# Proxys de confiance devant l'application (0 en local)
TRUST_PROXY=0

# Rendu PDF
PDF_MAX_CONCURRENCY=2
PDF_TIMEOUT_MS=20000
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# PDF_CHROMIUM_NO_SANDBOX=false

# Par défaut : true en production, false sinon
# HTTPS_ONLY=

# Pipeline IA (docs/adr/0008). vertex : seul admis en production.
# none | demo | anthropic (développement, données fictives, hors UE) | vertex
LLM_PROVIDER=demo
# LLM_MODEL=claude-opus-5-5
# VERTEX_PROJECT_ID=
# VERTEX_REGION=eu
# LLM_TIMEOUT_MS=90000
# LLM_MAX_COST_USD_PER_CV=0.3
# LLM_DAILY_QUOTA=10

# Comptes et veille emploi (docs/adr/0010). Sans SMTP_URL : comptes et veille désactivés.
# SMTP_URL=smtp://localhost:1025
# MAIL_FROM=Attesta <ne-pas-repondre@attesta.localhost>
# APP_BASE_URL=http://localhost:3000
# BREVO_WEBHOOK_TOKEN=
# Worker de veille : hash (tests, développement) ou tei (BGE-M3)
# EMBEDDINGS_PROVIDER=hash
# TEI_URL=http://localhost:8091
# JOBWATCH_SOURCES=ba
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ESCO_ENABLED=true
# JOBWATCH_LLM_MAX_COST_USD=0.1
