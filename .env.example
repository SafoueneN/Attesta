# Variables de la pile compose (compose.yaml), lues depuis .env ou un --env-file. Copier en .env.
# Ne jamais committer de .env : les secrets de préprod et de prod sont injectés par l'hébergeur.
# Chaque service a son propre .env.example pour un lancement hors Docker (services/*/.env.example).

# Adresse de contact affichée par les mentions légales et la politique de confidentialité (build du frontend).
# Obligatoire pour une image publique ; en local, contact@attesta.localhost par défaut.
CONTACT_EMAIL=

# Ports hôtes (valeurs par défaut)
# FRONTEND_PORT=8080
# GATEWAY_PORT=4000
# MAILPIT_PORT=8025

# Fournisseurs d'IA des services (docs/adr/0047). Vide : demo (aucun appel au modèle).
# claude | groq | cerebras | mistral | openrouter | gemini | ollama | demo | none ; repli sur 429 ou délai dépassé (vide : ordre par défaut).
# En production, seuls Claude sur Vertex AI (UE) et Ollama sont admis. Détail : services/*/.env.example.
AI_PROVIDER=
CLAUDE_TRANSPORT=
AI_FALLBACK_PROVIDERS=
VERTEX_PROJECT_ID=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# E-mails de la veille. Par défaut : Mailpit (aucun e-mail ne sort du poste). Vrai envoi : docs/runbook.md.
# SMTP_URL=smtp://mailpit:1025
# MAIL_FROM=Attesta <ne-pas-repondre@attesta.localhost>

# Sources d'offres sous clé (docs/adr/0031, 0035)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# JOOBLE_API_KEY=

# Vecteurs : hash (développement) ou tei (BGE-M3, profil compose « tei »)
# EMBEDDINGS_PROVIDER=hash

# Compte administrateur de la pile locale
# ADMIN_PASSWORD=admin-dev-uniquement
