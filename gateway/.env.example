# Copier en .env pour `npm run dev` (lu automatiquement). Ne jamais committer .env : valeurs de développement uniquement.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=0
AUTH_URL=http://localhost:4001
PROFILES_URL=http://localhost:4002
CV_GENERATION_URL=http://localhost:4003
JOBS_MATCHING_URL=http://localhost:4004
JOB_WATCH_URL=http://localhost:4005
LETTERS_EXPORT_URL=http://localhost:4006
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_HOUR=20
RATE_LIMIT_GENERATION_PER_HOUR=30
RATE_LIMIT_EXPORT_PER_HOUR=60
RATE_LIMIT_IMPORT_PER_HOUR=10
