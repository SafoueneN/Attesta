{
  "name": "@attesta/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Gateway d'Attesta : point d'entrée unique de l'API, JWT par JWKS, rôles, débit, en-têtes, corrélation.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@attesta/config": "file:../packages/config",
    "@attesta/http-kit": "file:../packages/http-kit",
    "@attesta/logger": "file:../packages/logger",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^3.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "jose": "^6.2.12",
    "supertest": "^7.3.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
