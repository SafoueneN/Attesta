{
  "name": "attesta",
  "version": "0.1.0",
  "private": true,
  "description": "Attesta, le CV qui dit vrai : CV ciblé par offre, prouvable ligne par ligne.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "tsc -b && vitest run",
    "test:coverage": "tsc -b && vitest run --coverage",
    "test:e2e": "playwright test e2e/frontend",
    "test:parite": "playwright test e2e/frontend",
    "demo:seed": "node scripts/demo-seed.mjs",
    "smtp:test": "node scripts/smtp-test.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "express": "^5.3.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
