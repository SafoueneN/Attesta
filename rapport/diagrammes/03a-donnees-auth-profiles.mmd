erDiagram
  app_user ||--o{ refresh_token : "possède"
  app_user ||--o{ recovery_code : "possède"
  app_user ||--o{ consent_log : "consent"
  app_user {
    uuid id PK
    text username UK "identifiant, minuscules"
    text email UK "facultatif (ADR 0030)"
    text password_hash "scrypt"
    text role "candidate ou admin"
    text status "active ou deleting"
    timestamptz created_at
    timestamptz last_active_at
  }
  refresh_token {
    uuid id PK
    uuid family_id "révocation par famille"
    uuid user_id FK
    bytea token_hash UK
    timestamptz expires_at
    timestamptz family_expires_at
    timestamptz used_at
    timestamptz revoked_at
  }
  recovery_code {
    uuid user_id PK
    bytea code_hash PK
    timestamptz used_at
  }
  consent_log {
    bigint id PK
    uuid user_id FK
    text purpose "service, veille, promo"
    boolean granted
    text policy_version
    text ip_hash
  }
  login_token {
    bytea token_hash PK
    text email
    timestamptz expires_at "15 min"
  }
  audit_event {
    bigint id PK
    text type
    uuid user_id
    jsonb detail
  }
  outbox {
    bigint id PK
    uuid user_id
    text target "service détenteur"
    text action "delete"
    int attempts
    timestamptz next_attempt_at
    timestamptz done_at
    timestamptz failed_at
  }
  profile_version {
    uuid id PK
    text user_id "UUID ou guest_uuid"
    int version
    jsonb data "schéma Profile"
    text schema_version
  }
  profile_evidence {
    uuid id PK
    text user_id
    text target "/work/0..."
    text kind
    text mime_type
    int size_bytes "5 Mo max"
    text anchor
    bytea content "AES-256-GCM"
  }
  profile_photo {
    text user_id PK
    text mime_type
    int size_bytes "2 Mo max"
    bytea content "AES-256-GCM"
  }
  app_user ||..o{ profile_version : "user_id logique"
  app_user ||..o{ profile_evidence : "user_id logique"
  app_user ||..o| profile_photo : "user_id logique"
  app_user ||..o{ outbox : "suppression à propager"
