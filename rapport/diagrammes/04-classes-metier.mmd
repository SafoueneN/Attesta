classDiagram
  direction LR
  class Profile {
    +Basics basics
    +Work[] work
    +Education[] education
    +Skill[] skills
    +Language[] languages
    +Project[] projects
    +Certificate[] certificates
  }
  class Basics {
    +string name
    +string label
    +string email
    +Location location
    +date birthDate
    +string nationality
    +string workPermit
  }
  class Work {
    +string name
    +string position
    +PartialDate startDate
    +PartialDate endDate
    +string[] highlights
  }
  class Education {
    +string institution
    +string area
    +string studyType
  }
  class Skill {
    +string name
    +string level
    +string[] keywords
  }
  class OfferAnalysis {
    +string title
    +string company
    +string language
    +Requirement[] requirements
    +Keyword[] keywords
  }
  class Requirement {
    +string text
    +string priority
    +string[] skills
  }
  class TailoredCv {
    +CvLine headline
    +CvLine[] summary
    +EntryWithLines[] work
    +EntryWithLines[] projects
    +Ref[] education
    +Ref[] skills
    +string[] missingKeywords
  }
  class CvLine {
    +string text
    +FactPointer[] sources
  }
  class FactPointer {
    <<pointeur JSON>>
    +string path
  }
  class FaithfulnessReport {
    +number score
    +int checkedLines
    +int supportedLines
    +LineCheck[] lines
  }
  class LineCheck {
    +string path
    +string status
    +Issue[] issues
  }
  class Issue {
    +string kind
    +string value
  }
  Profile *-- Basics
  Profile *-- "0..30" Work
  Profile *-- "0..15" Education
  Profile *-- "0..50" Skill
  OfferAnalysis *-- "0..40" Requirement
  TailoredCv *-- "1..*" CvLine
  CvLine --> "1..5" FactPointer
  FactPointer ..> Profile : désigne un fait
  FaithfulnessReport *-- LineCheck
  LineCheck *-- Issue
  FaithfulnessReport ..> TailoredCv : contrôle
  TailoredCv ..> OfferAnalysis : ciblé sur
