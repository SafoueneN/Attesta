# Copier en .env pour `npm run dev` (lu automatiquement). Ne jamais committer .env : valeurs de développement uniquement.
NODE_ENV=development
PORT=4001
LOG_LEVEL=info
TRUST_PROXY=0
# Base du service avec son rôle cloisonné (docs/adr/0013). En local : `docker compose up -d db db-init`.
DATABASE_URL=postgres://attesta_auth:attesta_auth-dev-uniquement@localhost:5433/attesta_auth
MIGRATE_ON_START=true
# Frontend (liens des e-mails) et SMTP (Mailpit en local : http://localhost:8025).
APP_BASE_URL=http://localhost:5173
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Attesta <ne-pas-repondre@attesta.localhost>
# Clé RS256 PKCS#8 (PEM, \n échappés) : obligatoire en production ; absente en local, clé éphémère.
# AUTH_PRIVATE_KEY=
AUTH_KEY_ID=cle-1
# Rôle administrateur à la connexion (docs/adr/0024).
ADMIN_EMAILS=admin@attesta.localhost
# Identifiants administrateurs, comptes par mot de passe (docs/adr/0030).
ADMIN_USERNAMES=admin
# Mot de passe initial des comptes administrateurs (secret, jamais versionné en production).
ADMIN_PASSWORD=admin-dev-uniquement
IP_HASH_SECRET=dev-ip-hash-secret-a-remplacer
COOKIE_PATH=/api/auth/v1/session
COOKIE_SECURE=false
# Secrets des services autorisés à demander un jeton de service (32 caractères au moins).
SERVICE_SECRET_JOB_WATCH=dev-secret-job-watch-uniquement-en-local-0000
# Services détenteurs de données (export et suppression RGPD) ; absent : service ignoré.
PROFILES_URL=http://localhost:4002
CV_GENERATION_URL=http://localhost:4003
JOBS_MATCHING_URL=http://localhost:4004
JOB_WATCH_URL=http://localhost:4005
LETTERS_EXPORT_URL=http://localhost:4006
