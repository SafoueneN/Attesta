# Copier en .env pour `npm run dev` (lu automatiquement). Ne jamais committer .env : valeurs de développement uniquement.
NODE_ENV=development
PORT=4005
LOG_LEVEL=info
TRUST_PROXY=0
# Base du service avec son rôle cloisonné (docs/adr/0013).
DATABASE_URL=postgres://attesta_watch:attesta_watch-dev-uniquement@localhost:5433/attesta_watch
MIGRATE_ON_START=true
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json
AUTH_URL=http://localhost:4001
PROFILES_URL=http://localhost:4002
JOBS_MATCHING_URL=http://localhost:4004
LETTERS_EXPORT_URL=http://localhost:4006
# Même valeur que SERVICE_SECRET_JOB_WATCH chez auth.
SERVICE_SECRET=dev-secret-job-watch-uniquement-en-local-0000
APP_BASE_URL=http://localhost:5173
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Attesta <ne-pas-repondre@attesta.localhost>
IP_HASH_SECRET=dev-ip-hash-secret-a-remplacer
# BREVO_WEBHOOK_TOKEN=
DAILY_RUN_ENABLED=false
DAILY_RUN_HOUR=7
