# Copier en .env pour `npm run dev` (lu automatiquement). Ne jamais committer .env.
NODE_ENV=development
PORT=4004
LOG_LEVEL=info
# Nombre de proxys de confiance devant le service (0 en local).
TRUST_PROXY=0
# Base du service avec son rôle cloisonné (docs/adr/0013). En local : `docker compose up -d db db-init`.
DATABASE_URL=postgres://attesta_jobs:attesta_jobs-dev-uniquement@localhost:5433/attesta_jobs
