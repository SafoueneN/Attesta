# Copier en .env pour `npm run dev` (lu automatiquement). Ne jamais committer .env : valeurs de développement uniquement.
NODE_ENV=development
PORT=4004
LOG_LEVEL=info
TRUST_PROXY=0
# Base du service avec son rôle cloisonné (docs/adr/0013).
DATABASE_URL=postgres://attesta_jobs:attesta_jobs-dev-uniquement@localhost:5433/attesta_jobs
MIGRATE_ON_START=true
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json
# Fournisseur (ADR 0047) : claude | groq | cerebras | mistral | openrouter | gemini | ollama ; demo : sans modèle ; none : aucun.
# Vide : ancien LLM_PROVIDER (anthropic ou vertex = claude), à défaut demo.
AI_PROVIDER=
# Claude : vertex (VERTEX_PROJECT_ID, région UE, seul admis en production, par défaut) ou anthropic.
CLAUDE_TRANSPORT=
# Repli sur quota atteint (429) ou délai dépassé. Vide : fournisseurs configurés suivants dans l'ordre
# claude, groq, cerebras, mistral, openrouter, gemini, ollama ; « none » : aucun ; sinon liste (groq,ollama). En production, seuls
# Claude sur Vertex et Ollama restent.
AI_FALLBACK_PROVIDERS=
# Modèle Claude.
LLM_MODEL=claude-opus-5-5
# Modèle par étape (ADR 0029, point 3), vide : LLM_MODEL partout. Recommandation :
# LLM_STEP_MODELS=explication-correspondance=claude-sonnet-5-5
LLM_STEP_MODELS=
LLM_TIMEOUT_MS=90000
# VERTEX_PROJECT_ID=
VERTEX_REGION=eu
# Secrets : jamais versionnés.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Vide : openai/gpt-oss-120b.
GROQ_MODEL=
CEREBRAS_API_KEY=
# Vide : gpt-oss-120b.
CEREBRAS_MODEL=
MISTRAL_API_KEY=
# Vide : mistral-small-latest.
MISTRAL_MODEL=
OPENROUTER_API_KEY=
# Vide : openai/gpt-oss-120b:free (suffixe « :free » : gratuit, quota faible).
OPENROUTER_MODEL=
GEMINI_API_KEY=
# Vide : gemini-3.8-flash (gemini-2.5-flash est fermé aux nouveaux comptes).
GEMINI_MODEL=
# Serveur Ollama (http://localhost:11434, ou http://ollama:11434 dans compose) ; vide : non configuré.
OLLAMA_BASE_URL=
# Vide : qwen3:8b.
OLLAMA_MODEL=
LLM_MONTHLY_BUDGET_EUR=4
# hash : vecteurs de développement ; tei : BGE-M3 (docker compose --profile tei up -d tei).
EMBEDDINGS_PROVIDER=hash
TEI_URL=http://localhost:8081
ESCO_ENABLED=true
BA_ENABLED=true
BA_DAILY_REQUESTS=500
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
ADZUNA_DAILY_REQUESTS=250
# Arbeitnow (DE), sans clé (docs/adr/0031).
ARBEITNOW_ENABLED=true
ARBEITNOW_DAILY_REQUESTS=20
# Catalogue d'offres, toutes régions (docs/adr/0034) : toutes les 6 h ; 0 la désactive.
CATALOGUE_SYNC_HOURS=6
# Sites carrière des employeurs (DE), sans clé : liste dans data/employeurs.json (docs/adr/0031).
EMPLOYERS_ENABLED=true
EMPLOYERS_DAILY_REQUESTS=600
# Flux RSS publics tunisiens (Tanitjobs, Tunisie Travail ; docs/adr/0035).
RSS_ENABLED=true
RSS_DAILY_REQUESTS=20
# Jooble (DE, FR) : clé gratuite sur https://jooble.org/api/about (secret, jamais versionné).
# JOOBLE_API_KEY=
JOOBLE_DAILY_REQUESTS=200
