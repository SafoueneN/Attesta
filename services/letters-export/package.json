{
  "name": "@attesta/letters-export",
  "version": "0.1.0",
  "private": true,
  "description": "Service letters-export d'Attesta : lettres de motivation et rendu PDF unique (CV, lettres, rapports).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "migrate": "node-pg-migrate up --migrations-dir migrations --migration-file-language sql",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "openapi": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@attesta/config": "file:../../packages/config",
    "@attesta/http-kit": "file:../../packages/http-kit",
    "@attesta/llm-client": "file:../../packages/llm-client",
    "@attesta/logger": "file:../../packages/logger",
    "@attesta/shared-schemas": "file:../../packages/shared-schemas",
    "express": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "ejs": "^3.1.10",
    "node-pg-migrate": "^9.0.0",
    "puppeteer": "^25.14.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "jose": "^6.2.12",
    "pdfjs-dist": "^6.4.299",
    "supertest": "^7.3.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
