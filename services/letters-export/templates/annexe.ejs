<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; font-src data:; img-src data:">
<title>Justificatifs – <%= view.name %></title>
<style><%- css %></style>
</head>
<body class="annexe">
<p class="annexe-surtitre">Annexe</p>
<h1>Justificatifs</h1>
<p class="annexe-candidat"><%= view.name %></p>
<p class="annexe-avertissement">
  Pièces jointes par le candidat à l'appui de son profil. Attesta ne certifie pas leur authenticité.
</p>
<ol class="annexe-liste">
<% view.items.forEach((item, i) => { -%>
  <li>
    <span class="annexe-num"><%= i + 1 %></span>
    <span>
      <strong><%= item.label %></strong>
      <span class="annexe-meta"><%= item.kind %> · appuie : <%= item.anchor %></span>
<% if (item.note) { -%>
      <span class="annexe-note"><%= item.note %></span>
<% } -%>
    </span>
  </li>
<% }) -%>
</ol>
</body>
</html>
