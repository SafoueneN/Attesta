# Copier en .env pour `npm run dev` (lu automatiquement). Ne jamais committer .env : valeurs de développement uniquement.
NODE_ENV=development
PORT=4002
LOG_LEVEL=info
TRUST_PROXY=0
# Base du service avec son rôle cloisonné (docs/adr/0013).
DATABASE_URL=postgres://attesta_profiles:attesta_profiles-dev-uniquement@localhost:5433/attesta_profiles
MIGRATE_ON_START=true
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json
# Fournisseur (ADR 0047) : claude | groq | cerebras | mistral | openrouter | gemini | ollama ; demo : sans modèle ; none : aucun.
# Vide : ancien LLM_PROVIDER (anthropic ou vertex = claude), à défaut demo.
AI_PROVIDER=
# Claude : vertex (VERTEX_PROJECT_ID, région UE, seul admis en production, par défaut) ou anthropic.
CLAUDE_TRANSPORT=
# Repli sur quota atteint (429) ou délai dépassé. Vide : fournisseurs configurés suivants dans l'ordre
# claude, groq, cerebras, mistral, openrouter, gemini, ollama ; « none » : aucun ; sinon liste (groq,ollama). En production, seuls
# Claude sur Vertex et Ollama restent.
AI_FALLBACK_PROVIDERS=
# Modèle Claude.
LLM_MODEL=claude-opus-5-5
# Modèle par étape (ADR 0029, point 3), vide : LLM_MODEL partout. Recommandation :
# LLM_STEP_MODELS=entretien-profil=claude-opus-5-5,faits-reponse=claude-opus-5-5
LLM_STEP_MODELS=
LLM_TIMEOUT_MS=90000
# VERTEX_PROJECT_ID=
VERTEX_REGION=eu
# Secrets : jamais versionnés.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Vide : openai/gpt-oss-120b.
GROQ_MODEL=
CEREBRAS_API_KEY=
# Vide : gpt-oss-120b.
CEREBRAS_MODEL=
MISTRAL_API_KEY=
# Vide : mistral-small-latest.
MISTRAL_MODEL=
OPENROUTER_API_KEY=
# Vide : openai/gpt-oss-120b:free (suffixe « :free » : gratuit, quota faible).
OPENROUTER_MODEL=
GEMINI_API_KEY=
# Vide : gemini-3.8-flash (gemini-2.5-flash est fermé aux nouveaux comptes).
GEMINI_MODEL=
# Serveur Ollama (http://localhost:11434, ou http://ollama:11434 dans compose) ; vide : non configuré.
OLLAMA_BASE_URL=
# Vide : qwen3:8b.
OLLAMA_MODEL=
LLM_MONTHLY_BUDGET_EUR=2
# Clé AES-256 des pièces justificatives (32 octets en base64), obligatoire en production (ADR 0027).
# Sans valeur hors production : clé de développement connue de tous. Générer : openssl rand -base64 32
# EVIDENCE_KEY=
